---
import Logo from "./Logo.astro";
const base = import.meta.env.BASE_URL;
const href = (path: string) => `${base}${path}`.replace(/\/+/g, "/");
---

<header class="site-header">
  <a class="brand-link" href={href("")} aria-label="Certael home"><Logo /></a>
  <nav class="desktop-nav" aria-label="Primary navigation">
    <a href={href("docs/")}>Docs</a>
    <a href={href("core/")}>Core</a>
    <a href={href("agent/")}>Agent</a>
    <a href={href("engines/")}>Engines</a>
    <a href={href("changelog/")}>Changelog</a>
    <a href={href("security/")}>Security</a>
    <a href={href("status/")}>Status</a>
  </nav>
  <a class="header-cta" href={href("get-started/")}>Install <span aria-hidden="true">↗</span></a>
  <details class="mobile-menu">
    <summary aria-label="Open navigation">Menu</summary>
    <nav aria-label="Mobile navigation">
      <a href={href("docs/")}>Docs</a>
      <a href={href("core/")}>Core</a>
      <a href={href("agent/")}>Agent</a>
      <a href={href("engines/")}>Engines</a>
      <a href={href("changelog/")}>Changelog</a>
      <a href={href("security/")}>Security</a>
      <a href={href("status/")}>Status</a>
      <a href={href("get-started/")}>Install Certael</a>
    </nav>
  </details>
</header>

<style>
  .site-header { width: min(calc(100% - 2rem), 1240px); margin: 1rem auto 0; min-height: 4rem; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; padding: .65rem .8rem .65rem 1rem; border: 1px solid var(--line); border-radius: 14px; background: var(--panel); position: sticky; top: .75rem; z-index: 40; }
  .brand-link { width: fit-content; text-decoration: none; }
  nav { display: flex; align-items: center; gap: 1.15rem; }
  nav a { color: var(--muted); text-decoration: none; font: 500 .75rem/1 var(--font-mono); letter-spacing: .06em; text-transform: uppercase; transition: color .2s ease; }
  nav a:hover, nav a:focus-visible { color: var(--text); }
  .header-cta { justify-self: end; border-radius: 9px; padding: .7rem 1rem; background: var(--text); color: #111116; text-decoration: none; font: 650 .74rem/1 var(--font-mono); letter-spacing: .04em; text-transform: uppercase; }
  .mobile-menu { display: none; position: relative; justify-self: end; }
  .mobile-menu summary { min-width: 48px; min-height: 44px; display: grid; place-items: center; border: 1px solid var(--line-bright); border-radius: 8px; color: var(--text); cursor: pointer; list-style: none; font-weight: 650; }
  .mobile-menu summary::-webkit-details-marker { display: none; }
  .mobile-menu nav { position: absolute; top: calc(100% + .7rem); right: 0; width: min(280px, calc(100vw - 2rem)); display: grid; gap: 0; padding: .5rem; border: 1px solid var(--line-bright); border-radius: 10px; background: var(--panel-raised); }
  .mobile-menu nav a { min-height: 44px; display: flex; align-items: center; padding: .6rem .7rem; color: var(--subtle); text-decoration: none; }
  .mobile-menu nav a:hover, .mobile-menu nav a:focus-visible { color: var(--text); background: var(--panel); }
  @media (max-width: 760px) {
    .site-header { grid-template-columns: 1fr auto; }
    .desktop-nav, .header-cta { display: none; }
    .mobile-menu { display: block; }
  }
</style>
