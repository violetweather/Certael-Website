---
import Logo from "./Logo.astro";
const base = import.meta.env.BASE_URL;
const href = (path: string) => `${base}${path}`.replace(/\/+/g, "/");
---

<header class="site-header">
  <a class="brand-link" href={href("")}><Logo /></a>
  <nav aria-label="Primary navigation">
    <a href={href("core/")}>Core</a>
    <a href={href("agent/")}>Agent</a>
    <a href={href("engines/")}>Engines</a>
    <a href={href("changelog/")}>Changelog</a>
    <a href={href("security/")}>Security</a>
    <a href={href("status/")}>Status</a>
  </nav>
  <a class="header-cta" href={href("get-started/")}>Install <span aria-hidden="true">↗</span></a>
</header>

<style>
  .site-header { width: min(calc(100% - 2rem), 1240px); margin: 1rem auto 0; min-height: 4rem; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; padding: .65rem .8rem .65rem 1rem; border: 1px solid var(--line); border-radius: 14px; background: rgb(13 13 17 / .76); backdrop-filter: blur(20px); position: sticky; top: .75rem; z-index: 40; box-shadow: 0 12px 40px rgb(0 0 0 / .24); }
  .brand-link { width: fit-content; text-decoration: none; }
  nav { display: flex; align-items: center; gap: 1.35rem; }
  nav a { color: var(--muted); text-decoration: none; font: 500 .75rem/1 var(--font-mono); letter-spacing: .06em; text-transform: uppercase; transition: color .2s ease; }
  nav a:hover, nav a:focus-visible { color: var(--text); }
  .header-cta { justify-self: end; border-radius: 9px; padding: .7rem 1rem; background: var(--text); color: #111116; text-decoration: none; font: 650 .74rem/1 var(--font-mono); letter-spacing: .04em; text-transform: uppercase; }
  @media (max-width: 760px) {
    .site-header { grid-template-columns: 1fr auto; }
    nav { display: none; }
  }
</style>
