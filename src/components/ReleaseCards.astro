---
import { getReleases } from "../lib/releases";
const releases = await getReleases();
---

<div class="release-grid">
  {releases.map((release) => (
    <article class="release-card">
      <div><span class="signal-dot"></span>{release.product === "Core" ? "Authoritative foundation" : "Optional user-mode companion"}</div>
      <h3>Certael {release.product}</h3>
      <p class="release-tag">{release.tag}</p>
      <p>{release.product === "Core" ? "Engine packages, native runtime, server SDK, and self-hosted backend." : "Ready-to-run Agent builds for Windows, macOS, and Linux."}</p>
      <a class="button secondary" href={release.url}>View release <span aria-hidden="true">↗</span></a>
    </article>
  ))}
</div>
