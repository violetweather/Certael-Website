---
import BaseLayout from "../layouts/BaseLayout.astro";
import SystemMap from "../components/SystemMap";
import CapabilityGrid from "../components/CapabilityGrid.astro";
import ReleaseCards from "../components/ReleaseCards.astro";
import SetupBuilder from "../components/SetupBuilder";
import { securityTruths } from "../data/site";
const base = import.meta.env.BASE_URL;
const href = (path: string) => `${base}${path}`.replace(/\/+/g, "/");
---

<BaseLayout>
  <section class="hero shell">
    <div class="hero-grid">
      <div class="hero-copy">
        <div class="version-chip">Pre-1.0 security engineering release</div>
        <p class="eyebrow">Cross-engine anti-cheat foundation</p>
        <h1>Server authority, <span class="gradient-text">reinforced.</span></h1>
        <p class="lede">Certael protects the request path for Godot, Unity, and Unreal games. Core validates authoritative actions. The optional Agent adds signed user-mode integrity evidence.</p>
        <div class="button-row">
          <a class="button primary" href={href("get-started/")}>Install Certael <span aria-hidden="true">↗</span></a>
          <a class="button secondary" href="#architecture">Explore architecture</a>
        </div>
      </div>
      <div class="hero-visual">
        <SystemMap client:visible />
        <div class="hero-stats" aria-label="Certael attributes">
          <div class="hero-stat"><strong>3</strong><span>Engines</span></div>
          <div class="hero-stat"><strong>User mode</strong><span>Agent</span></div>
          <div class="hero-stat"><strong>Server</strong><span>Authority</span></div>
        </div>
      </div>
    </div>
  </section>

  <section class="section shell" id="architecture">
    <div class="split-heading">
      <div><p class="eyebrow">Two layers, one trust boundary</p><h2>Secure the action.<br />Measure the environment.</h2></div>
      <p>Core and Agent solve different problems. They become useful together only when the dedicated game server remains authoritative.</p>
    </div>
    <div class="prose-grid">
      <article class="prose-card">
        <p class="eyebrow">01 / Certael Core</p>
        <h3>Prevent invalid state changes</h3>
        <p>Authenticate and sequence player requests, execute game-specific validation against trusted state, commit atomically, and record explainable evidence.</p>
        <a class="button secondary" href={href("core/")}>Explore Core</a>
      </article>
      <article class="prose-card">
        <p class="eyebrow">02 / Certael Agent</p>
        <h3>Add optional integrity evidence</h3>
        <p>Launch approved builds, maintain a private local channel, and produce fresh signed reports without a kernel driver or unrelated-device surveillance.</p>
        <a class="button secondary" href={href("agent/")}>Explore Agent</a>
      </article>
    </div>
  </section>

  <section class="section shell">
    <div class="split-heading">
      <div><p class="eyebrow">Capability matrix</p><h2>Designed for more than shooters.</h2></div>
      <p>Protect economies, movement, progression, racing, card games, strategy, social systems, and competitive action games through server-owned rules.</p>
    </div>
    <CapabilityGrid limit={6} />
  </section>

  <section class="section shell">
    <div class="split-heading">
      <div><p class="eyebrow">Install path</p><h2>Build your Certael setup.</h2></div>
      <p>Choose an engine and whether the protected mode uses Core alone or the optional Agent companion.</p>
    </div>
    <SetupBuilder client:load />
  </section>

  <section class="section shell">
    <div class="split-heading">
      <div><p class="eyebrow">Security language</p><h2>Proof without pretending.</h2></div>
      <p>Certael describes exactly what each proof establishes—and what it cannot establish on a player-controlled machine.</p>
    </div>
    <table class="truth-table">
      <thead><tr><th>Observation</th><th>What it establishes</th><th>What it does not establish</th></tr></thead>
      <tbody>{securityTruths.map((row) => <tr>{row.map((cell) => <td>{cell}</td>)}</tr>)}</tbody>
    </table>
  </section>

  <section class="section shell">
    <div class="split-heading">
      <div><p class="eyebrow">Current builds</p><h2>Start with a verified release.</h2></div>
      <p>Download Core for your engine. Add Agent only for protected online modes that benefit from user-mode integrity evidence.</p>
    </div>
    <ReleaseCards />
  </section>
</BaseLayout>
